# ---------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------
# Lokale Entwicklung. In docker-compose wird DATABASE_URL aus den POSTGRES_*-Werten gebildet.
DATABASE_URL="postgresql://termin:termin@localhost:5432/termin"
POSTGRES_USER="termin"
# Produktion: langes Zufallspasswort, z. B. openssl rand -base64 24
POSTGRES_PASSWORD="termin"
POSTGRES_DB="termin"

# ---------------------------------------------------------------
# Produktion (docker-compose)
# ---------------------------------------------------------------
# E-Mail für Let's Encrypt (Ablaufwarnungen)
ACME_EMAIL="admin@example.at"
# Öffentlicher age-Schlüssel für verschlüsselte Backups (deploy/backup.sh)
BACKUP_AGE_RECIPIENT=""

# ---------------------------------------------------------------
# Plattform
# ---------------------------------------------------------------
# Öffentliche Basis-URL der Plattform (ohne Pfad). Betriebe sind unter
# <slug>.<host> erreichbar, z. B. https://mayer.termin-app.at
PLATFORM_BASE_URL="http://localhost:3000"
PLATFORM_NAME="Termin-App"
# Optional: Einzelinstanz für genau einen Betrieb. Dann wird jede Domain
# diesem Betrieb zugeordnet und der Plattformbereich liegt unter /plattform.
SINGLE_TENANT_SLUG=""

# 32 Byte, base64. Erzeugen mit: openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# Für mehrere Instanzen hinter einem Load Balancer (Next.js Server Actions)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Hinter Caddy/Reverse Proxy: X-Forwarded-For vertrauen (für Rate-Limits)
TRUST_PROXY="true"
# Cookies nur über HTTPS (in Produktion immer true)
COOKIE_SECURE="false"

# Erster Plattform-Admin (für `npm run platform-admin:create`)
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_NAME=""

# ---------------------------------------------------------------
# Betreiberangaben (Impressum/Datenschutz der Plattform, AVV)
# ---------------------------------------------------------------
OPERATOR_NAME="Muster IT e.U."
OPERATOR_LEGAL_FORM="Einzelunternehmen (eingetragener Unternehmer)"
OPERATOR_STREET="Musterstraße 1"
OPERATOR_POSTAL_CODE="1010"
OPERATOR_CITY="Wien"
OPERATOR_COUNTRY="Österreich"
OPERATOR_EMAIL="office@example.at"
OPERATOR_PHONE=""
OPERATOR_UID=""
OPERATOR_COMPANY_REGISTER_NUMBER=""
OPERATOR_COMPANY_REGISTER_COURT=""
OPERATOR_BUSINESS_PURPOSE="Entwicklung und Betrieb von Softwarelösungen"
OPERATOR_SUPERVISORY_AUTHORITY="Magistratisches Bezirksamt des I. Bezirks"
OPERATOR_CHAMBER="Wirtschaftskammer Wien, Fachgruppe UBIT"
OPERATOR_PRIVACY_EMAIL="datenschutz@example.at"

# Unterauftragsverarbeiter (erscheinen in AVV und Datenschutzerklärung)
HOSTING_PROVIDER="Hetzner Online GmbH, Industriestr. 25, 91710 Gunzenhausen, Deutschland"
HOSTING_LOCATION="Rechenzentrum in der EU (Falkenstein/Nürnberg, Deutschland)"
MAIL_PROVIDER="(bitte eintragen: SMTP-Anbieter der Plattform, Sitz in der EU)"

# ---------------------------------------------------------------
# E-Mail-Versand der Plattform (Standard für alle Betriebe ohne eigenes SMTP)
# ---------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@example.at"
# Ohne SMTP_HOST werden E-Mails nur ins Server-Log geschrieben (Entwicklung).

# ---------------------------------------------------------------
# Web-Push (VAPID). Erzeugen mit: npm run vapid:generate
# ---------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:office@example.at"

# ---------------------------------------------------------------
# WhatsApp Business Cloud API
# ---------------------------------------------------------------
WHATSAPP_GRAPH_VERSION="v23.0"
# Nur für Tests: Nachrichten nicht wirklich senden, sondern loggen
WHATSAPP_DRY_RUN="false"
