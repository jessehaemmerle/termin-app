// Datenmodell der White-Label-Terminplattform.
//
// Grundsätze:
// - Jeder personenbezogene Datensatz hängt an genau einem Betrieb (tenantId).
//   Betriebe sind Verantwortliche, die Plattform ist Auftragsverarbeiterin.
// - Alle Zeitpunkte werden als timestamptz (UTC) gespeichert, Anzeige in der
//   Zeitzone des Betriebs.
// - Geheimnisse (SMTP-Passwort, WhatsApp-Token, TOTP) liegen AES-256-GCM-
//   verschlüsselt in Feldern mit Suffix "Enc".
// - Tokens (Sessions, Links) werden nur als SHA-256-Hash gespeichert.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  PLATFORM_ADMIN
  OWNER
  MANAGER
  STAFF
}

enum ServiceKind {
  INDIVIDUAL
  GROUP
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_BUSINESS
  NO_SHOW
  COMPLETED
  EXPIRED
}

enum BookingSource {
  ONLINE
  ADMIN
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  PUSH
}

enum NotificationType {
  BOOKING_RECEIVED
  BOOKING_CONFIRMED
  BOOKING_DECLINED
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  BOOKING_REMINDER
  WAITLIST_AVAILABLE
  STAFF_NEW_BOOKING
  STAFF_BOOKING_CANCELLED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum AuthTokenPurpose {
  INVITE
  PASSWORD_RESET
  EMAIL_VERIFY
}

enum ConsentChannel {
  WHATSAPP
}

enum AssetKind {
  LOGO
  ICON_192
  ICON_512
  ICON_MASKABLE
  APPLE_TOUCH
}

model Tenant {
  id     String       @id @default(cuid())
  slug   String       @unique
  name   String
  status TenantStatus @default(ACTIVE)

  customDomain            String?   @unique
  customDomainVerifiedAt  DateTime? @db.Timestamptz(3)
  domainVerificationToken String

  // Darstellung
  tagline      String?
  description  String?
  primaryColor String  @default("#1F5F8B")

  // Impressum (§ 5 ECG, § 25 MedienG, § 14 UGB)
  legalName            String?
  legalForm            String?
  street               String?
  postalCode           String?
  city                 String?
  country              String  @default("Österreich")
  phone                String?
  email                String?
  uidNumber            String?
  companyRegisterNumber String?
  companyRegisterCourt String?
  businessPurpose      String?
  supervisoryAuthority String?
  chamber              String?
  professionTitle      String?
  tradeRegulations     String? @default("Gewerbeordnung 1994 (GewO), abrufbar unter www.ris.bka.gv.at")
  privacyContactEmail  String?
  dpoName              String?
  dpoEmail             String?
  additionalTerms      String?

  // Buchungsregeln
  timezone                  String  @default("Europe/Vienna")
  slotIntervalMinutes       Int     @default(15)
  minLeadMinutes            Int     @default(120)
  maxAdvanceDays            Int     @default(60)
  cancellationDeadlineHours Int     @default(24)
  requireApproval           Boolean @default(false)
  requirePhone              Boolean @default(false)
  allowCustomerAccounts     Boolean @default(true)
  waitlistEnabled           Boolean @default(true)
  require2faForStaff        Boolean @default(false)

  // Benachrichtigungen
  reminderHoursBefore Int     @default(24)
  notifyStaffByEmail  Boolean @default(true)

  // Eigener E-Mail-Versand (optional, sonst Plattform-SMTP)
  smtpHost        String?
  smtpPort        Int?
  smtpSecure      Boolean @default(true)
  smtpUser        String?
  smtpPasswordEnc String?
  smtpFromEmail   String?
  smtpFromName    String?

  // WhatsApp Business Cloud API (eigenes Konto des Betriebs)
  whatsappEnabled         Boolean @default(false)
  whatsappPhoneNumberId   String?
  whatsappAccessTokenEnc  String?
  whatsappDisplayNumber   String?
  whatsappTemplateLang    String  @default("de")
  whatsappTplConfirmation String  @default("termin_bestaetigung")
  whatsappTplReminder     String  @default("termin_erinnerung")
  whatsappTplCancellation String  @default("termin_absage")
  whatsappTplWaitlist     String  @default("termin_warteliste")

  // Datenschutz
  retentionMonths Int @default(12)

  // Auftragsverarbeitungsvertrag & Nutzungsbedingungen
  dpaAcceptedAt       DateTime? @db.Timestamptz(3)
  dpaVersion          String?
  dpaAcceptedByUserId String?
  termsVersion        String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  assets            TenantAsset[]
  users             User[]
  staff             Staff[]
  services          Service[]
  resources         Resource[]
  workingHours      WorkingHours[]
  timeOff           TimeOff[]
  groupSessions     GroupSession[]
  customers         Customer[]
  bookings          Booking[]
  waitlistEntries   WaitlistEntry[]
  consentRecords    ConsentRecord[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  pushSubscriptions PushSubscription[]
  sessions          Session[]
}

model TenantAsset {
  tenantId  String
  kind      AssetKind
  mime      String
  data      Bytes
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, kind])
}

// Login-Konten für Betriebsinhaber, Mitarbeiter und Plattform-Admins.
model User {
  id                 String    @id @default(cuid())
  tenantId           String?
  email              String
  name               String
  role               UserRole
  passwordHash       String?
  totpSecretEnc      String?
  totpEnabledAt      DateTime? @db.Timestamptz(3)
  totpRecoveryHashes String[]  @default([])
  failedLogins       Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)
  lastLoginAt        DateTime? @db.Timestamptz(3)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff             Staff?
  sessions          Session[]
  authTokens        AuthToken[]
  pushSubscriptions PushSubscription[]

  @@unique([tenantId, email])
}

// Buchbare Person. Kann (muss aber nicht) mit einem Login verknüpft sein.
model Staff {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String?  @unique
  name            String
  bio             String?
  color           String   @default("#1F5F8B")
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  usesTenantHours Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  services      StaffService[]
  workingHours  WorkingHours[]
  timeOff       TimeOff[]
  bookings      Booking[]
  groupSessions GroupSession[]

  @@index([tenantId])
}

// Wöchentliche Zeiten. staffId = null -> Öffnungszeiten des Betriebs.
// weekday: 1 = Montag … 7 = Sonntag, Minuten ab Mitternacht (Ortszeit).
model WorkingHours {
  id          String @id @default(cuid())
  tenantId    String
  staffId     String?
  weekday     Int
  startMinute Int
  endMinute   Int

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffId])
}

// Abwesenheit eines Mitarbeiters oder (staffId = null) Schließtag des Betriebs.
model TimeOff {
  id       String   @id @default(cuid())
  tenantId String
  staffId  String?
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)
  label    String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt])
}

model Resource {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  capacity  Int      @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services ServiceResource[]
  bookings BookingResource[]

  @@index([tenantId])
}

model Service {
  id                  String      @id @default(cuid())
  tenantId            String
  name                String
  description         String?
  category            String?
  kind                ServiceKind @default(INDIVIDUAL)
  durationMinutes     Int
  bufferBeforeMinutes Int         @default(0)
  bufferAfterMinutes  Int         @default(0)
  priceCents          Int?
  priceFrom           Boolean     @default(false)
  groupCapacity       Int?
  active              Boolean     @default(true)
  sortOrder           Int         @default(0)
  createdAt           DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3)

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff           StaffService[]
  resources       ServiceResource[]
  bookings        Booking[]
  groupSessions   GroupSession[]
  waitlistEntries WaitlistEntry[]

  @@index([tenantId])
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model ServiceResource {
  serviceId  String
  resourceId String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([serviceId, resourceId])
}

// Termin eines Gruppenangebots (Kurs), auf den mehrere Kunden buchen.
model GroupSession {
  id          String    @id @default(cuid())
  tenantId    String
  serviceId   String
  staffId     String?
  startsAt    DateTime  @db.Timestamptz(3)
  endsAt      DateTime  @db.Timestamptz(3)
  capacity    Int
  note        String?
  cancelledAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff           Staff?          @relation(fields: [staffId], references: [id], onDelete: SetNull)
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]

  @@index([tenantId, startsAt])
}

// Kunde eines Betriebs. Gilt nur für diesen Betrieb (kein plattformweites Konto).
// passwordHash gesetzt -> Kundenkonto, sonst Gastkunde.
model Customer {
  id                 String    @id @default(cuid())
  tenantId           String
  name               String
  email              String?
  phone              String?
  whatsappOptIn      Boolean   @default(false)
  passwordHash       String?
  emailVerifiedAt    DateTime? @db.Timestamptz(3)
  totpSecretEnc      String?
  totpEnabledAt      DateTime? @db.Timestamptz(3)
  totpRecoveryHashes String[]  @default([])
  failedLogins       Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)
  internalNote       String?
  lastActivityAt     DateTime  @default(now()) @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  consentRecords  ConsentRecord[]
  sessions        Session[]
  authTokens      AuthToken[]

  @@unique([tenantId, email])
  @@index([tenantId, phone])
}

model Booking {
  id             String        @id @default(cuid())
  tenantId       String
  customerId     String?
  serviceId      String
  staffId        String?
  groupSessionId String?
  startsAt       DateTime      @db.Timestamptz(3)
  endsAt         DateTime      @db.Timestamptz(3)
  // Belegter Zeitraum inkl. Pufferzeiten (für Kollisionsprüfung)
  blockedFrom    DateTime      @db.Timestamptz(3)
  blockedUntil   DateTime      @db.Timestamptz(3)
  status         BookingStatus @default(CONFIRMED)
  source         BookingSource @default(ONLINE)
  customerNote   String?
  // Telefonnummer für Benachrichtigungen zu diesem Termin
  phone          String?
  notifyEmail    Boolean       @default(true)
  notifyWhatsapp Boolean       @default(false)
  // Verwaltungslink: Hash zur Suche, verschlüsselt für Links in Erinnerungen
  manageTokenHash String?      @unique
  manageTokenEnc  String?
  cancelledAt     DateTime?    @db.Timestamptz(3)
  reminderQueuedAt DateTime?   @db.Timestamptz(3)
  anonymizedAt    DateTime?    @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  service       Service           @relation(fields: [serviceId], references: [id], onDelete: NoAction)
  staff         Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  groupSession  GroupSession?     @relation(fields: [groupSessionId], references: [id], onDelete: Cascade)
  resources     BookingResource[]
  notifications Notification[]

  @@index([tenantId, startsAt])
  @@index([staffId, blockedFrom])
  @@index([customerId])
  @@index([groupSessionId])
}

model BookingResource {
  bookingId  String
  resourceId String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([bookingId, resourceId])
}

// Warteliste: entweder für einen Tag + Leistung (Einzeltermine)
// oder für einen ausgebuchten Gruppentermin.
model WaitlistEntry {
  id             String    @id @default(cuid())
  tenantId       String
  customerId     String
  serviceId      String
  staffId        String?
  date           String?
  groupSessionId String?
  notifyWhatsapp Boolean   @default(false)
  tokenHash      String    @unique
  tokenEnc       String
  notifiedAt     DateTime? @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  groupSession GroupSession? @relation(fields: [groupSessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, serviceId, date])
}

// Nachweis von Einwilligungen (Art. 7 Abs. 1 DSGVO), z. B. WhatsApp-Benachrichtigung.
model ConsentRecord {
  id          String         @id @default(cuid())
  tenantId    String
  customerId  String
  channel     ConsentChannel
  granted     Boolean
  textVersion String
  source      String
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// Ausgehende Nachrichten (Outbox). Inhalte werden erst beim Versand aus den
// aktuellen Daten erzeugt und nicht gespeichert (Datenminimierung).
model Notification {
  id            String              @id @default(cuid())
  tenantId      String
  bookingId     String?
  waitlistEntryId String?
  userId        String?
  channel       NotificationChannel
  type          NotificationType
  status        NotificationStatus  @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now()) @db.Timestamptz(3)
  lockedAt      DateTime?           @db.Timestamptz(3)
  sentAt        DateTime?           @db.Timestamptz(3)
  lastError     String?
  providerRef   String?
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
}

model Session {
  id          String    @id
  userId      String?
  customerId  String?
  tenantId    String?
  mfaVerified Boolean   @default(false)
  expiresAt   DateTime  @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerId])
}

model AuthToken {
  id         String           @id @default(cuid())
  tokenHash  String           @unique
  purpose    AuthTokenPurpose
  userId     String?
  customerId String?
  expiresAt  DateTime         @db.Timestamptz(3)
  usedAt     DateTime?        @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Rechenschaftspflicht (Art. 5 Abs. 2 DSGVO): wer hat wann was geändert.
// Keine IP-Adressen, keine Inhalte – nur Aktion und betroffene Objekt-ID.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorType  String
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}
